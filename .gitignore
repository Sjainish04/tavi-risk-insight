# ============================================================
# SECRETS — NEVER COMMIT
# ============================================================
.env
.env.*
!.env.example
api/.env
api/.env.*
!api/.env.example
web/.env
web/.env.*
!web/.env.example
SECRETS.md
*.secret
*.key
*.pem

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
.uv/
# uv.lock IS committed for reproducibility — do not gitignore

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ============================================================
# Node / Vite / React
# ============================================================
node_modules/
dist/
dist-ssr/
.turbo/
.vite/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
# Models & data — large, regenerated by train.py
# ============================================================
api/models/*.pkl
api/models/*.joblib
api/models/*.json
!api/models/.gitkeep

api/data/raw/*
api/data/interim/*
api/data/processed/*
!api/data/raw/.gitkeep
!api/data/interim/.gitkeep
!api/data/processed/.gitkeep

# ============================================================
# Editor / OS
# ============================================================
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ============================================================
# Docker
# ============================================================
.docker/

# ============================================================
# External vendored repos + their venvs + downloaded models
# (cloned/downloaded by setup; regenerated by deploy script)
# ============================================================
external/synthea/
external/synthea/output/
external/tavr/
external/tavr-venv/
external/tavr-cache/
external/torch-hub-cache/

# Synthea, Brüggemann checkpoint, MONAI SwinViT etc. are pulled
# during environment setup — see deploy/ scripts. Never commit.

# ============================================================
# Generated artifacts (large; reproducible from scripts)
# ============================================================
api/artifacts/*.parquet

# ============================================================
# Misc
# ============================================================
*.pid
*.seed
*.pid.lock
.cache
coverage/
