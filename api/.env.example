# ============================================================
# TAVI Risk Insight — API environment (EXAMPLE)
# ============================================================
# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is committed.
# ============================================================

# ----- App config ---------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# CORS allow-list — comma-separated origins
# Add your deployed frontend URL here in production
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Rate limit on /explain (per-IP, per-minute)
RATE_LIMIT_EXPLAIN=10/minute

# ----- LLM provider switch ------------------------------------
# Allowed: watsonx | featherless | huggingface | ollama | premium
# Production target: watsonx (IBM Granite + Granite Guardian safety filter)
LLM_PROVIDER=watsonx

# ----- IBM watsonx.ai (region: us-south recommended) ----------
# Mint API key:    https://cloud.ibm.com/iam/apikeys
# Create project:  https://dataplatform.cloud.ibm.com/projects
# Project must have a watsonx.ai Runtime service associated.
WATSONX_API_KEY=
WATSONX_API_KEY_BACKUP=
WATSONX_PROJECT_ID=
WATSONX_REGION=us-south
WATSONX_BASE_URL=https://us-south.ml.cloud.ibm.com

# Foundation model IDs (us-south menu)
GRANITE_MODEL_ID=ibm/granite-4-h-small
GRANITE_GUARDIAN_MODEL_ID=ibm/granite-guardian-3-8b
GRANITE_FALLBACK_MODEL_ID=ibm/granite-13b-instruct-v2
LLAMA_FALLBACK_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# ----- Featherless AI (cloud fallback #1, OpenAI-compatible) --
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=BioMistral/BioMistral-7B-DARE
FEATHERLESS_MODEL_COMPARE=deepseek-ai/DeepSeek-V3

# ----- Hugging Face Inference API (fallback #2) ---------------
HF_TOKEN=
HF_MODEL=BioMistral/BioMistral-7B

# ----- ollama (offline fallback #3) ---------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ----- Premium (fallback #4) ----------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ----- IBM Cloud Key Protect (production crypto target) -------
KEY_PROTECT_INSTANCE_ID=
KEY_PROTECT_API_KEY=
KEY_PROTECT_ROOT_KEY_ID=
KEY_PROTECT_BASE_URL=https://us-south.kms.cloud.ibm.com
WATSONX_API_KEY_ENCRYPTED=

# ----- brdav inference microservice ---------------------------
# Local dev:  http://127.0.0.1:8001/infer
# Code Engine: http://tavi-brdav.<project>.svc.cluster.local:8001/infer
# HF Spaces:   https://<user>-tavi-brdav.hf.space/infer
BRDAV_URL=http://127.0.0.1:8001/infer

# ----- TabPFN cloud (optional — only used by offline batch) ---
# Get a token: https://ux.priorlabs.ai/account
TABPFN_TOKEN=

# ----- Model artifacts ----------------------------------------
MODEL_DIR=models
DATA_DIR=data
