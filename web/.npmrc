# Reduce pnpm 11's strict-build-approval noise.
# es5-ext's postinstall is just a sponsor-message echo — safe to skip.
# The pnpm.onlyBuiltDependencies field in package.json already approves
# the packages whose scripts we actually want to run (esbuild).
loglevel=warn
strict-peer-dependencies=false
auto-install-peers=true
